# ===========================================
# Chat Skills 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值
# ===========================================

# -------------------------------------------
# AI 配置
# -------------------------------------------
# OpenAI 兼容的 API Key
OPENAI_API_KEY=sk-your-api-key-here

# API Base URL (可选，默认为 OpenAI 官方)
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型 (可选，默认 gpt-4o)
OPENAI_MODEL=gpt-4o

# Skills 目录路径 (可选)
SKILLS_DIR=~/.claude/skills

# -------------------------------------------
# 数据库配置
# -------------------------------------------
# 存储类型: 'sqlite' 或 'postgresql'
STORAGE_TYPE=sqlite

# SQLite 配置 (当 STORAGE_TYPE=sqlite 时使用)
SQLITE_PATH=./data/chat-skills.db

# PostgreSQL 配置 (当 STORAGE_TYPE=postgresql 时使用)
# DATABASE_URL=postgresql://user:password@localhost:5432/chatskills

# -------------------------------------------
# 认证配置 (next-auth)
# -------------------------------------------
# 是否启用登录认证 (true/false，默认 false)
# 设为 false 时使用浏览器指纹作为用户标识，无需登录
# 设为 true 时需要配置下方的 Google OAuth
AUTH_ENABLED=false

# 随机密钥，用于加密 session
# 生成方式: openssl rand -base64 32
AUTH_SECRET=your-random-secret-key-here

# Docker 环境需要设置为 true
AUTH_TRUST_HOST=true

# Google OAuth 配置
# 在 Google Cloud Console 创建 OAuth 2.0 凭据:
# https://console.cloud.google.com/apis/credentials
# 授权重定向 URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
